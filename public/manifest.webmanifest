{
	"name": "Aurelia Bakehouse — Order · Classes · Catering",
	"short_name": "Aurelia",
	"description": "A white-label bakehouse app: menu ordering, classes, catering, gift cards, rewards and ambience. Fully configurable per client.",
	"lang": "en",
	"dir": "ltr",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["standalone", "minimal-ui"],
	"orientation": "portrait",
	"background_color": "#0e0b08",
	"theme_color": "#0e0b08",
	"categories": ["food", "shopping", "lifestyle"],
	"icons": [
		{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
	],
	"shortcuts": [
		{ "name": "Order", "short_name": "Menu", "url": "/?screen=menu", "description": "Browse the menu" },
		{ "name": "Rewards", "short_name": "Rewards", "url": "/?screen=rewards", "description": "Your loyalty" }
	]
}
