# Copier ce fichier en « .env » et remplir. Les lignes vides/commentées sont ignorées.

# — Vision + rédaction (obligatoire hors dry-run) —
ANTHROPIC_API_KEY=

# — Ingestion Leboncoin (obligatoire pour le réel) —
APIFY_TOKEN=
APIFY_ACTOR_LEBONCOIN_FR=

# — Pépites Manager (recommandé : canal principal) —
PEPITES_API_URL=
ENGINE_TOKEN=

# — Notifications Discord (optionnel, webhook du salon ; vide = app seule) —
DISCORD_WEBHOOK_URL=

# — Mode découverte : 1 (défaut) = si rien ne passe le seuil, envoyer quand
#   même le meilleur candidat du passage, étiqueté DÉCOUVERTE. 0 = couper. —
DISCOVERY_MODE=

# — Telegram (optionnel) —
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# — Comps eBay vendus (optionnel) —
SOLDCOMPS_URL=
SOLDCOMPS_KEY=
# Taux de conversion vers EUR (approximatifs par défaut : 0.90 / 1.15)
FX_USD_EUR=
FX_GBP_EUR=
